; Crumb's theme, "Marching Off-Step": a stomping, slightly out-of-step march in G minor, 118 bpm (guitar rock with a comic streak). Original notes, no rom lines.
; Form: the koto hook with the fuzz riff answering (A), the band (B), a lead-guitar solo (S), the hook with everything (C); 32 bars, 65 s. Two comic stops (end of B, end of S) and a slide whistle.
song crumb
tempo 118
meter 4/4
reverb 173
priority 0

inst rg   = B.10 shift=20   ; distortion guitar (power chords)
inst rgm  = B.11 shift=20   ; palm-muted guitar (chugs)
inst lead = A.38 shift=12   ; overdriven lead guitar
inst koto = A.117 shift=0   ; plucked koto: the hook
inst fz   = A.97 shift=24   ; fuzz bass
inst whis = A.77 shift=-12  ; flute: the slide whistle
inst kit  = A.120
inst timp = A.47 shift=24

hit kick=36 rim=37 clap=39 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49

track 1 inst=koto vol=100 pan=8 vel=112 gate=70 gain=1.3
track 2 inst=fz vol=100 pan=0 vel=118 gate=78 gain=0.8
track 3 inst=rg vol=127 pan=-18 vel=124 gate=88 gain=1.0
track 4 inst=kit vol=74 pan=0 vel=108 gate=100 gain=0.6
track 5 inst=timp vol=84 pan=0 vel=118 gate=92 gain=1.4
track 6 inst=lead vol=110 pan=8 vel=118 gate=96 gain=0.85 bendr=12 lfos=40 lfodl=12
track 7 inst=whis vol=100 pan=12 vel=112 gate=90 gain=1.3 bendr=12

