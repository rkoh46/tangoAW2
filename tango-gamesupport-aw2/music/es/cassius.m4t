; Cassius, commander of the Emerald Sun cavalry: "Equitatus", a cavalry gallop in G.
; Original composition for tangoAW2. Every beat is the gallop (an eighth and two sixteenths); a bugle calls the charge,
; the horns swagger over it with a little scoop into the high notes.
;
; Form: a four-bar bugle call, then the loop: the swagger theme (A), the call and answer in E minor (B), the theme with
; the second horn and strings chopping (A2), and the charge (C). 32 bars at 144 beats a minute: about 54 s.
song cassius
tempo 144
meter 4/4
reverb 173
priority 0

inst horn    = A.56  shift=-12      ; the lead
inst horn2   = A.111 shift=-12      ; the second horn
inst strings = A.48                 ; chopped chords
inst bass    = A.34  shift=24       ; the gallop's low beat
inst timp    = A.47  shift=24
inst kit     = A.120
inst flute   = A.77  shift=-12      ; bright runs over the charge

hit kick=36 rim=37 clap=39 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49 crash2=57

track 1 inst=horn    vol=84 pan=0   vel=110 gate=85 gain=1.45
track 2 inst=horn2   vol=60 pan=-22 vel=98  gate=85 gain=1.6
track 3 inst=strings vol=62 pan=22  vel=94  gate=80 gain=2.4
track 4 inst=bass    vol=84 pan=0   vel=118 gate=75 gain=0.65
track 5 inst=timp    vol=76 pan=8   vel=120 gate=90 gain=0.65
track 6 inst=kit     vol=70 pan=0   vel=106 gate=100 gain=0.85
track 7 inst=flute   vol=56 pan=-8  vel=110 gate=90 gain=2.5

; ---- the theme (G F C G | G F C D) ----
def thA:
  | G4/8 G4/16 G4/16 B4/8 B4/16 B4/16 D5/4 D5/8 E5/8 |
  | F5/4. E5/8 D5/4 C5/4 |
  | E5/8 E5/16 E5/16 G5/8 G5/16 G5/16 C6/4 B5/8 A5/8 |
  | G5/2 D5/4 B4/4 |
  | G4/8 G4/16 G4/16 B4/8 B4/16 B4/16 D5/4 G5/4 |
  | A5/4. G5/8 F5/4 E5/4 |
  | G5/8 G5/16 G5/16 E5/8 E5/16 E5/16 C5/4 D5/4 |
  | D5/2 r/8 D5/8 F#5/8 A5/8 |
end
def thAh:
  | E4/8 E4/16 E4/16 G4/8 G4/16 G4/16 B4/4 B4/8 C5/8 |
  | D5/4. C5/8 B4/4 A4/4 |
  | C5/8 C5/16 C5/16 E5/8 E5/16 E5/16 G5/4 G5/8 F5/8 |
  | D5/2 B4/4 G4/4 |
  | E4/8 E4/16 E4/16 G4/8 G4/16 G4/16 B4/4 D5/4 |
  | F5/4. E5/8 D5/4 C5/4 |
  | E5/8 E5/16 E5/16 C5/8 C5/16 C5/16 G4/4 B4/4 |
  | B4/2 r/8 B4/8 D5/8 F#5/8 |
end
; ---- the call and answer (Em D C D | Em D C D) ----
def thB:
  | E5/4. E5/8 G5/4 B5/4 |
  | A5/4. F#5/8 D5/2 |
  | G5/4. E5/8 C5/2 |
  | F#5/8 G5/8 A5/8 F#5/8 D5/2 |
  | E5/4. E5/8 G5/4 B5/4 |
  | A5/4. G5/8 F#5/2 |
  | E5/4. G5/8 C6/2 |
  | B5/8 A5/8 G5/8 F#5/8 D5/4 r/4 |
end
; ---- the charge ----
def thC:
  | G5/8 G5/16 G5/16 B5/8 B5/16 B5/16 D6/4 B5/4 |
  | A5/4. G5/8 F5/4 C5/4 |
  | C6/4. B5/8 A5/4 G5/4 |
  | G5/2 D5/2 |
  | G5/8 G5/16 G5/16 B5/8 B5/16 B5/16 D6/4 B5/4 |
  | A5/4. G5/8 F5/4 C5/4 |
  | C6/4. B5/8 A5/4 G5/4 |
  | D5/4 D5/4 D5/4 r/4 |
end
; the flute's run over the charge: sixteenths up the chord
def run:
  | G5/16 B5/16 D6/16 B5/16 G5/16 B5/16 D6/16 B5/16 G5/16 B5/16 D6/16 B5/16 G5/16 B5/16 D6/16 B5/16 |
end

; ---- the gallop: bass and timpani on the chord root (G; -2 is F, +5 is C, +7 is D) ----
def gb:
  | G1/8 G2/16 G1/16 G1/8 G2/16 G1/16 G1/8 G2/16 G1/16 G1/8 G2/16 G1/16 |
end
def gt:
  | G2/8 G2/16 G2/16 r/4 G2/8 G2/16 G2/16 r/4 |
end
; strings chopping on the offbeats: the major chord's third and fifth (written for G)
def chopG:
  | r/8 B3/8' r/8 B3/8' r/8 B3/8' r/8 B3/8' |
end
def chopEm:
  | r/8 G3/8' r/8 G3/8' r/8 G3/8' r/8 G3/8' |
end
; ---- drums ----
def kg:
  | kick/8 hat/16 hat/16 snare/8 hat/16 hat/16 kick/8 hat/16 hat/16 snare/8 hat/16 hat/16 |
end
def kgc:
  | crash/8 hat/16 hat/16 snare/8 hat/16 hat/16 kick/8 hat/16 hat/16 snare/8 hat/16 hat/16 |
end
def kgt:
  | kick/8 hat/16 hat/16 snare/8 hat/16 hat/16 kick/8 hat/16 hat/16 tom1/16 tom1/16 tom2/16 tom2/16 |
end
def h8:
  | hat/8 hat/16 hat/16 hat/8 hat/16 hat/16 hat/8 hat/16 hat/16 hat/8 hat/16 hat/16 |
end
def s16:
  snare/16 snare/16 snare/16 snare/16
end
def roll:
  | @s16*4 |
end

; ---- the bugle call ----
section intro bars=4
  1: {vol 86} | G4/8 C5/8 E5/8 G5/8 C6/2 | r/2 G5/8 E5/8 C5/8 G4/8 | G4/8 C5/8 E5/8 G5/8 C6/4 G5/4 | G5/4 r/4 D5/8 D5/8 D5/4 |
  5: | G2/2 r/2 | r/1 | G2/8 G2/16 G2/16 G2/8 G2/16 G2/16 G2/8 G2/16 G2/16 G2/8 G2/16 G2/16 | G2/8 G2/16 G2/16 r/4 G2/8 G2/16 G2/16 r/4 |
  6: {vol 20>74/384} | r/1 | r/1 | @h8 | @h8 |
end

; ---- the swagger ----
section A bars=8
  1: {vol 84} @thA
  3: {vol 62} @chopG @chopG-2 @chopG+5 @chopG @chopG @chopG-2 @chopG+5 @chopG+7
  4: @gb @gb-2 @gb+5 @gb @gb @gb-2 @gb+5 @gb+7
  5: @gt @gt-2 @gt+5 @gt @gt @gt-2 @gt+5 @gt+7
  6: {vol 70} @kg*7 @roll
end

; ---- the call and answer ----
section B bars=8
  1: {vol 86} @thB
  3: {vol 58} @chopEm @chopG+7 @chopG+5 @chopG+7 @chopEm @chopG+7 @chopG+5 @chopG+7
  4: @gb+9 @gb+7 @gb+5 @gb+7 @gb+9 @gb+7 @gb+5 @gb+7
  5: @gt+9 @gt+7 @gt+5 @gt+7 @gt+9 @gt+7 @gt+5 @gt+7
  6: {vol 68} @kg*7 @roll
end

; ---- the theme with the second horn ----
section A2 bars=8
  1: {vol 84} @thA
  2: {vol 60} @thAh
  3: {vol 64} @chopG @chopG-2 @chopG+5 @chopG @chopG @chopG-2 @chopG+5 @chopG+7
  4: {vol 86} @gb @gb-2 @gb+5 @gb @gb @gb-2 @gb+5 @gb+7
  5: {vol 78} @gt @gt-2 @gt+5 @gt @gt @gt-2 @gt+5 @gt+7
  6: {vol 72} @kgc @kg @kg @kgt @kgc @kg @kg @roll
end

; ---- the charge ----
section C bars=8
  1: {vol 90} @thC
  3: {vol 66} @chopG @chopG-2 @chopG+5 @chopG @chopG @chopG-2 @chopG+5 @chopG+7
  4: {vol 88} @gb @gb-2 @gb+5 @gb @gb @gb-2 @gb+5 @gb+7
  5: {vol 82} @gt @gt-2 @gt+5 @gt @gt @gt-2 @gt+5 @gt+7
  6: {vol 76} @kgc @kg @kg @kgt @kgc @kg @kg @roll
  7: {vol 54} @run | r/1 | @run | r/1 | @run | r/1 | @run | r/1 |
end

form intro loop A B A2 C
