; Asuka, final theme "Cold Iron Fingers" (K + N): a dark rock theme in E minor / E harmonic minor, 120 bpm. K's pick-bass and guitar riff in unison with its chromatic drop (B Bb A)
; and its brass tune; N's fingered sixteenth lead and its runs. Intro 4 bars, loop 32 bars (64 s). Original.
song asuka
tempo 120
meter 4/4
reverb 173
priority 0

inst bass = A.36  shift=24
inst gtr  = A.27  shift=12
inst brs  = A.56  shift=-12
inst fing = A.27  shift=12
inst horn = A.111 shift=-12
inst kit  = A.120
inst timp = A.47  shift=24
hit kick=36 rim=37 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49

track 1 inst=bass vol=100 pan=0   vel=120 gate=75 gain=1.82
track 2 inst=gtr  vol=80  pan=-16 vel=112 gate=70 gain=0.49
track 3 inst=brs  vol=84  pan=10  vel=108 gate=88 gain=1.51
track 4 inst=fing vol=90  pan=14  vel=116 gate=85 gain=0.95
track 5 inst=horn vol=70  pan=-8  vel=108 gate=85 gain=1.01
track 6 inst=kit  vol=74  pan=0   vel=108 gate=100 gain=0.56
track 7 inst=timp vol=84  pan=0   vel=120 gate=92 gain=0.91

; K's riff (bass at octave 2, guitar the same +12)
def ra:
  | E2/8 E2/8 G2/8 E2/8 r/8 E2/8 A2/8 G2/8 |
end
def rb:
  | E2/8 E2/8 G2/8 E2/8 r/8 B2/8 Bb2/8 A2/8 |
end
def rc:
  | C3/8 C3/8 D3/8 C3/8 r/8 C3/8 E3/8 D3/8 |
end
def rd:
  | B2/8 B2/8 D3/8 B2/8 r/8 B2/8 F#3/8 E3/8 |
end
def rm:
  | B2/8 B2/8 D#3/8 B2/8 r/8 B2/8 F#3/8 E3/8 |
end
def rs:
  | r/1 |
end
; K's brass tune
def t1:
  | B3/4. B3/8 E4/4 G4/4 | | F#4/4. E4/8 B3/2 | | C4/4. C4/8 E4/4 G4/4 | | F#4/2 D#4/2 |
  | G4/4. B4/8 C5/4 B4/4 | | A4/4. G4/8 E4/2 | | G4/4. A4/8 B4/4 C5/4 | | E4/4 r/4 r/2 |
end
def t2a:
  | B3/4. B3/8 E4/4 G4/4 | | F#4/4. E4/8 B3/2 |
end
def t2b:
  | C4/4. C4/8 E4/4 G4/4 | | F#4/2 D#4/2 |
end
def hi1:
  | E5/4. G5/8 A5/4 G5/4 | | F#5/4. E5/8 B4/2 |
end
; N's fingered lead
def n1:
  | E4/16 G4/16 B4/16 G4/16 E4/16 G4/16 B4/16 C5/16 B4/16 G4/16 E4/16 G4/16 B4/16 C5/16 B4/16 G4/16 |
end
def n2:
  | A3/16 C4/16 E4/16 C4/16 A3/16 C4/16 E4/16 A4/16 E4/16 C4/16 A3/16 C4/16 E4/16 A4/16 E4/16 C4/16 |
end
def n3:
  | B3/16 D#4/16 F#4/16 D#4/16 B3/16 D#4/16 F#4/16 B4/16 F#4/16 D#4/16 B3/16 D#4/16 F#4/16 B4/16 F#4/16 D#4/16 |
end
def n4:
  | E4/16 G4/16 B4/16 G4/16 E4/16 G4/16 B4/16 G4/16 B4/4 C5/4 |
end
def n5:
  | C5/16 B4/16 A4/16 B4/16 G4/16 A4/16 F#4/16 G4/16 E4/16 F#4/16 D#4/16 E4/16 B3/16 C4/16 A3/16 B3/16 |
end
def n6:
  | E4/16 D#4/16 E4/16 B3/16 G4/16 F#4/16 G4/16 E4/16 B4/16 A4/16 B4/16 G4/16 C5/16 B4/16 C5/16 A4/16 |
end
def n8:
  | B4/4 G4/4 E4/2 |
end
def nl:
  | E3/16 G3/16 B3/16 G3/16 E3/16 G3/16 B3/16 C4/16 B3/16 G3/16 E3/16 G3/16 B3/16 C4/16 B3/16 G3/16 |
end
def c1:
  | E4/16 F4/16 F#4/16 G4/16 G#4/16 A4/16 A#4/16 B4/16 C5/16 B4/16 A#4/16 A4/16 G#4/16 G4/16 F#4/16 F4/16 |
end
def c2:
  | B3/16 C4/16 C#4/16 D4/16 D#4/16 E4/16 F4/16 F#4/16 G4/16 F#4/16 F4/16 E4/16 D#4/16 D4/16 C#4/16 C4/16 |
end
def cd:
  | A4/16 G#4/16 G4/16 F#4/16 F4/16 E4/16 D#4/16 D4/16 C#4/16 C4/16 B3/16 A#3/16 A3/16 G#3/16 G3/16 F#3/16 |
end
; drums
def kb:
  | kick/8 hat/8 snare/8 hat/8 kick/8 kick/8 snare/8 hat/8 |
end
def kc:
  | crash/8 hat/8 snare/8 hat/8 kick/8 kick/8 snare/8 hat/8 |
end
def kf:
  | kick/8 hat/8 snare/8 hat/8 tom1/16 tom1/16 tom2/16 tom2/16 tom3/16 tom3/16 snare/16 snare/16 |
end
def kq:
  | kick/4 rim/4 kick/4 rim/4 |
end
def kt:
  | kick/4. kick/4. kick/4 |
end
def tk:
  | E2/4 r/4 E2/4 r/4 |
end
def hs:
  | E3/4 r/4 E3/4 r/4 |
end

; intro: K's riff, hit hard
section I bars=4
  1: @ra @rb @ra @rb
  2: @ra+12 @rb+12 @ra+12 @rb+12
  3: @rs*4
  4: @rs*4
  5: @hs*4
  6: @kc @kb @kb @kf
  7: @tk*4
end

; A: the riff and K's brass tune
section A bars=8
  1: @ra @rb @rc @rd @ra @rb @ra @rb
  2: @ra+12 @rb+12 @rc+12 @rd+12 @ra+12 @rb+12 @ra+12 @rb+12
  3: @t1
  4: @rs*8
  5: @rs*4 | E3/2 B3/2 | | A3/2 E3/2 | | B3/2 F#3/2 | | E3/4 r/4 r/2 |
  6: @kc @kb @kb @kf @kb @kb @kb @kf
  7: @rs*8
end

; B: N's fingered lead over a variation of the riff (E Am B E C E C B)
section B bars=8
  1: @ra @ra+5 @rm @rb @rc @ra @rc @rd
  2: @ra+12 @ra+17 @rm+12 @rb+12 @rc+12 @ra+12 @rc+12 @rd+12
  3: @rs*8
  4: @n1 @n2 @n3 @n4 @n5 @n6 @n5 @n8
  5: | E3/1 | | A3/1 | | B3/1 | | E3/1 | | C4/1 | | E3/1 | | C4/1 | | B3/1 |
  6: @kb @kb @kb @kf @kb @kb @kb @kf
  7: @rs*8
end

; breakdown: the riff alone
section D bars=4
  1: @ra @rb @ra @rb
  2: @ra+12 @rb+12 @ra+12 @rb+12
  3: @rs*4
  4: @rs*4
  5: @rs*4
  6: @kq*3 @kf
  7: @tk*4
end

; the return: N's lead and K's brass trade phrases
section R bars=8
  1: @ra @rb @rc @rd @ra @rb @ra @rb
  2: @ra+12 @rb+12 @rc+12 @rd+12 @ra+12 @rb+12 @ra+12 @rb+12
  3: @t2a @rs*2 @hi1 @rs | E5/2. r/4 |
  4: @rs*2 @n5 @n3 @nl @n5 @c1 | E4/4 r/4 r/2 |
  5: | E3/1 | | E3/1 | | C4/1 | | B3/1 | | E3/1 | | E3/1 | | E3/1 | | E3/1 |
  6: @kc @kb @kb @kf @kc @kb @kb @kf
  7: @tk*2 @rs*6
end

; turnaround: the chromatic drop back into the loop
section T bars=4
  1: @rc @rd | B2/4. Bb2/4. A2/4 | | G2/4 F#2/4 F#2/4 r/4 |
  2: @rc+12 @rd+12 | B3/4. Bb3/4. A3/4 | | G3/4 F#3/4 F#3/4 r/4 |
  3: @rs*2 | B4/4. Bb4/4. A4/4 | | G4/4 F#4/4 E4/2 |
  4: @c1 @c2 @rs @cd
  5: | C4/1 | | B3/1 | | B3/4. Bb3/4. A3/4 | | G3/4 F#3/4 E3/2 |
  6: @kb @kf @kt @kf
  7: @rs*4
end

form I loop A B D R T
