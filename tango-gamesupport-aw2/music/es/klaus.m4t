; Klaus, legate of the Emerald Sun: "Legio Aeterna", a stately legion march in D minor.
; Original composition for tangoAW2. Written at the sounding pitch; `shift` turns it into the key each AW2 sample needs.
;
; Form: a four-bar fanfare, then the loop: the march theme (A), the theme again with the second brass and a crash on the
; downbeats (A2), a trio in F major for the strings (B), and the theme once more with everything (A3).
; 32 bars at 108 beats a minute: about 71 s.
song klaus
tempo 108
meter 4/4
reverb 173
priority 0

inst trumpet = A.56  shift=-12      ; the bright lead AW2 uses for its marches (Olaf, Drake, Sensei)
inst horns   = A.111 shift=-12      ; rich brass for the second line
inst strings = A.48                 ; string ensemble
inst bass    = A.34  shift=24       ; electric bass
inst timp    = A.47  shift=24       ; the low drum Olaf's and Drake's marches use
inst kit     = A.120                ; AW2's drum kit

hit kick=36 rim=37 clap=39 snare=40 hat=44 ohat=46 tom1=45 tom2=48 crash=49 crash2=57

track 1 inst=trumpet vol=84 pan=0   vel=108 gate=88 gain=1.45
track 2 inst=horns   vol=62 pan=-24 vel=96  gate=92 gain=1.1
track 3 inst=strings vol=64 pan=24  vel=90  gate=90 gain=1.5
track 4 inst=bass    vol=84 pan=0   vel=118 gate=85 gain=0.8
track 5 inst=timp    vol=78 pan=10  vel=120 gate=95 gain=0.6
track 6 inst=kit     vol=72 pan=0   vel=108 gate=100 gain=0.85

; ---- the theme, in D minor ----
def thA:
  | D5/4. C5/8 D5/4 A4/4 |
  | Bb4/4. A4/8 G4/4 F4/4 |
  | A4/4. G4/8 A4/4 D5/4 |
  | C5/2 A4/2 |
  | D5/4. E5/8 F5/4 E5/4 |
  | D5/4. C5/8 Bb4/4 A4/4 |
  | G4/4. A4/8 Bb4/4 C5/4 |
  | D5/2. r/4 |
end
; the same, a third below
def thAh:
  | Bb4/4. A4/8 Bb4/4 F4/4 |
  | G4/4. F4/8 E4/4 D4/4 |
  | F4/4. E4/8 F4/4 Bb4/4 |
  | A4/2 F4/2 |
  | Bb4/4. C5/8 D5/4 C5/4 |
  | Bb4/4. A4/8 G4/4 F4/4 |
  | E4/4. F4/8 G4/4 A4/4 |
  | Bb4/2. r/4 |
end
; the oom-pah: the upper two notes of a minor chord on 2 and 4 (written for D minor), of a major chord (written for Bb)
def pahm:
  | r/4 [F3 A3]/8' r/8 r/4 [F3 A3]/8' r/8 |
end
def pahM:
  | r/4 [D4 F4]/8' r/8 r/4 [D4 F4]/8' r/8 |
end

; ---- march drums ----
def s16:
  snare/16 snare/16 snare/16 snare/16
end
def mA:
  | kick/4 snare/8 snare/8 kick/4 snare/4 |
end
def mB:
  | kick/4 snare/4 kick/8 kick/8 snare/8 snare/16 snare/16 |
end
def mC:
  | [crash kick]/4 snare/8 snare/8 kick/4 snare/4 |
end
def roll:
  | @s16*4 |
end
def soft:
  | kick/4 hat/4 rim/4 hat/4 |
end

; ---- timpani and bass on the chord roots of the theme: Dm Gm Dm Am Bb Gm Gm Dm ----
def tD:
  | D2/4 r/4 D2/8 D2/8 D2/4 |
end
def tG:
  | G1/4 r/4 G1/8 G1/8 G1/4 |
end
def tA:
  | A1/4 r/4 A1/8 A1/8 A1/4 |
end
def tB:
  | Bb1/4 r/4 Bb1/8 Bb1/8 Bb1/4 |
end
def bD:
  | D2/4 r/4 A2/4 r/4 |
end
def bG:
  | G2/4 r/4 D3/4 r/4 |
end
def bA:
  | A1/4 r/4 E2/4 r/4 |
end
def bB:
  | Bb1/4 r/4 F2/4 r/4 |
end
def bG2:
  | G1/4 r/4 D2/4 r/4 |
end

; ---- the fanfare ----
section intro bars=4
  1: {vol 84} | A4/4. A4/8 D5/2 | F5/4. E5/8 D5/2 | A4/4. A4/8 D5/4 F5/4 | A5/2. r/4 |
  5: | D2/2 r/2 | r/1 | D2/2 r/2 | D2/4 D2/4 D2/4 D2/4 |
  6: {vol 20>96/384} | @s16*4 | @s16*4 | @s16*4 | @s16*4 |
end

; ---- the theme, march and brass ----
section A bars=8
  1: {vol 84} @thA
  3: {vol 64} @pahm | @pahm+5 | @pahm | @pahm+7 | @pahM | @pahm+5 | @pahm+5 | @pahm
  4: @bD @bG @bD @bA @bB @bG2 @bG2 | D2/4 r/4 D2/2 |
  5: @tD @tG @tD @tA @tB @tG @tG | D2/4 r/4 D2/2 |
  6: {vol 72} @mA @mA @mA @mB @mA @mA @mA @roll
end

; ---- the theme again, with the second brass and a crash on the downbeats ----
section A2 bars=8
  1: @thA
  2: {vol 62} @thAh
  3: @pahm | @pahm+5 | @pahm | @pahm+7 | @pahM | @pahm+5 | @pahm+5 | @pahm
  4: @bD @bG @bD @bA @bB @bG2 @bG2 | D2/4 r/4 D2/2 |
  5: @tD @tG @tD @tA @tB @tG @tG | D2/4 r/4 D2/2 |
  6: @mC @mA @mA @mB @mC @mA @mA @roll
end

; ---- the trio, in F major: the strings sing, the horns hold, the drums go soft ----
section B bars=8
  2: {vol 46} | [C4 F4]/1 | [E4 Bb4]/1 | [C4 F4]/1 | [E4 G4]/1 | [C4 F4]/1 | [D4 Bb4]/1 | [E4 Bb4]/1 | [E4 A4]/1 |
  3: {vol 84} !92 | A4/2 C5/4 F5/4 | E5/2. D5/4 | C5/2 Bb4/4 A4/4 | G4/2. r/4 | A4/2 C5/4 F5/4 | G5/2. F5/4 | E5/4 D5/4 C5/4 Bb4/4 | A4/2. r/4 |
  4: | F2/1 | C2/1 | F2/1 | C2/1 | F2/1 | G2/1 | C2/1 | A1/1 |
  5: {vol 50} | F2/2 r/2 | r/1 | F2/2 r/2 | r/1 | F2/2 r/2 | r/1 | C2/2 r/2 | A1/2 A1/2 |
  6: {vol 40} @soft*7 | @s16*4 |
end

; ---- the theme a last time: everything at once ----
section A3 bars=8
  1: {vol 90} @thA
  2: {vol 70} @thAh
  3: {vol 70} @pahm | @pahm+5 | @pahm | @pahm+7 | @pahM | @pahm+5 | @pahm+5 | @pahm
  4: {vol 86} @bD @bG @bD @bA @bB @bG2 @bG2 | D2/4 r/4 D2/2 |
  5: {vol 84} @tD @tG @tD @tA @tB @tG @tG | D2/4 r/4 D2/2 |
  6: {vol 80} @mC @mA @mC @mB @mC @mA @mC @roll
end

form intro loop A A2 B A3
