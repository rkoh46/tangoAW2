; Asuka's theme, take T3 "Defector's Cry": the lead guitar hook up front, E minor with the flat second, 124 bpm. Original notes, no rom lines.
song asuka
tempo 124
meter 4/4
reverb 173
priority 0

inst rg   = B.10 shift=20   ; distortion guitar (power chords, sustained)
inst rgm  = B.11 shift=20   ; palm-muted guitar (the chugs)
inst lead = A.38 shift=12   ; overdriven lead guitar
inst gtr  = A.27 shift=12   ; plucked guitar (arpeggios)
inst bass = A.97 shift=24   ; fuzz bass
inst brass = A.56 shift=-12 ; stabs
inst kit  = A.120
inst timp = A.47 shift=24
hit kick=36 rim=37 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49

track 1 inst=rg    vol=127 pan=-18 vel=120 gate=90 gain=1.0
track 2 inst=bass  vol=100 pan=0   vel=118 gate=78 gain=0.65
track 3 inst=lead  vol=120 pan=6   vel=120 gate=96 gain=0.85 bendr=12 lfos=40 lfodl=12
track 4 inst=gtr   vol=84  pan=-8  vel=108 gate=80 gain=0.5
track 5 inst=kit   vol=74  pan=0   vel=108 gate=100 gain=0.52
track 6 inst=timp  vol=84  pan=0   vel=118 gate=92 gain=1.3
track 7 inst=brass vol=84  pan=10  vel=110 gate=88 gain=1.2

