; Asuka's theme, take T2 "Grinder": heavier, more chug, a darker riff: E Phrygian with the tritone, 118 bpm. Original notes, no rom lines.
song asuka
tempo 118
meter 4/4
reverb 173
priority 0

inst rg   = B.10 shift=20   ; distortion guitar (power chords, sustained)
inst rgm  = B.11 shift=20   ; palm-muted guitar (the chugs)
inst lead = A.38 shift=12   ; overdriven lead guitar
inst gtr  = A.27 shift=12   ; plucked guitar (arpeggios)
inst bass = A.97 shift=24   ; fuzz bass
inst brass = A.56 shift=-12 ; stabs
inst kit  = A.120
inst timp = A.47 shift=24
hit kick=36 rim=37 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49

track 1 inst=rg    vol=127 pan=-18 vel=127 gate=88 gain=1.0
track 2 inst=bass  vol=100 pan=0   vel=118 gate=78 gain=0.75
track 3 inst=lead  vol=110 pan=8   vel=118 gate=96 gain=0.75 bendr=12 lfos=40 lfodl=12
track 4 inst=gtr   vol=84  pan=-8  vel=108 gate=80 gain=0.8
track 5 inst=kit   vol=74  pan=0   vel=108 gate=100 gain=0.56
track 6 inst=timp  vol=84  pan=0   vel=118 gate=92 gain=1.4
track 7 inst=brass vol=84  pan=10  vel=110 gate=88 gain=1.3

