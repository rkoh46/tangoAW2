; Aurelia, chief engineer of the Emerald Sun: "Opus Machinae", a determined, mechanical theme in A minor.
; Original composition for tangoAW2. A plucked ostinato runs like a engine under punchy brass; the bridge opens up
; for the strings and a high koto line, and the last section winds the machine up with snare rolls.
;
; Form: a four-bar start-up (ostinato alone, then bass, then drums), then the loop: theme (A), bridge (B), theme with
; horns and a counter line (A2), the push (C). 32 bars at 128 beats a minute: about 60 s.
song aurelia
tempo 128
meter 4/4
reverb 173
priority 0

inst brass   = A.56  shift=-12      ; the punchy lead
inst horns   = A.111 shift=-12      ; second brass, the harmony
inst pluck   = A.27  shift=12       ; the ostinato: a plucked string
inst koto    = A.117                ; the high counter line: a bright pluck
inst bass    = A.36  shift=24       ; pick bass
inst strings = A.48                 ; string pad
inst kit     = A.120

hit kick=36 rim=37 clap=39 snare=40 hat=44 ohat=46 tom1=45 tom2=48 tom3=50 crash=49

track 1 inst=brass   vol=82 pan=0   vel=120 gate=72 gain=1.55
track 2 inst=pluck   vol=70 pan=-26 vel=100 gate=85 gain=0.45
track 3 inst=koto    vol=62 pan=30  vel=96  gate=95 gain=1.6
track 4 inst=bass    vol=80 pan=0   vel=118 gate=80 gain=0.8
track 5 inst=strings vol=60 pan=14  vel=88  gate=100 gain=1.5
track 6 inst=kit     vol=72 pan=0   vel=106 gate=100 gain=0.85
track 7 inst=horns   vol=60 pan=-14 vel=100 gate=70 gain=1.4

; ---- the machine: power chords as a tresillo of sixteenths (written for Am; +2 is G, -4 is F, -5 is E) ----
def ost:
  | A2/16> E3/16 A3/16 A2/16> E3/16 A3/16 A2/16> E3/16 A3/16 A2/16> E3/16 A3/16 A2/16> E3/16 A2/16> E3/16 |
end
; the bass: pumping eighths
def pump:
  | A1/8 A1/8 A2/8 A1/8 A1/8 A1/8 A2/8 A1/8 |
end
; a half bar of each for the bridge
def pumpl:
  | A1/4 r/4 A1/4 r/4 |
end

; ---- the brass theme ----
def thA:
  | A4/8. A4/16 C5/8. C5/16 E5/4 r/4 |
  | D5/8. D5/16 C5/8. C5/16 A4/4 r/4 |
  | C5/8. C5/16 F5/8. F5/16 A5/4 r/4 |
  | B4/8. B4/16 D5/8. D5/16 G5/4 r/4 |
  | A4/8. A4/16 C5/8. C5/16 E5/4 E5/8 D5/8 |
  | C5/4 D5/4 E5/4 G5/4 |
  | F5/4. E5/8 D5/4 C5/4 |
  | B4/2 r/4 E5/8 E5/8 |
end
; the same line a third below, in the horns (the notes that fit the chords)
def thAh:
  | E4/8. E4/16 A4/8. A4/16 C5/4 r/4 |
  | F4/8. F4/16 A4/8. A4/16 E4/4 r/4 |
  | A4/8. A4/16 C5/8. C5/16 F5/4 r/4 |
  | G4/8. G4/16 B4/8. B4/16 D5/4 r/4 |
  | E4/8. E4/16 A4/8. A4/16 C5/4 C5/8 B4/8 |
  | A4/4 B4/4 C5/4 E5/4 |
  | D5/4. C5/8 B4/4 A4/4 |
  | G#4/2 r/4 B4/8 B4/8 |
end
; the push: the theme climbing
def thC:
  | A4/8. A4/16 C5/8. C5/16 E5/8. E5/16 A5/8. A5/16 |
  | D5/8. D5/16 F5/8. F5/16 A5/8. A5/16 C6/8. C6/16 |
  | C5/8. C5/16 E5/8. E5/16 G5/8. G5/16 C6/8. C6/16 |
  | B4/8. B4/16 D5/8. D5/16 G5/8. G5/16 B5/8. B5/16 |
  | A4/8. A4/16 C5/8. C5/16 E5/8. E5/16 A5/8. A5/16 |
  | F5/4. E5/8 D5/4 C5/4 |
  | E5/4. D5/8 C5/4 B4/4 |
  | [E5 G#4]/1 |
end
; the koto's counter line: broken chords, eight eighths a bar (Am; F major written, +2 is G, -1 is E)
def arpm:
  | A4/8 C5/8 E5/8 A5/8 E5/8 C5/8 A4/8 C5/8 |
end
def arpM:
  | F4/8 A4/8 C5/8 F5/8 C5/8 A4/8 F4/8 A4/8 |
end

; ---- drums ----
def h4:
  hat/16 hat/16 hat/16 hat/16
end
def s16:
  snare/16 snare/16 snare/16 snare/16
end
def roll:
  | @s16*4 |
end
def kA:
  | kick/16 hat/16 hat/16 hat/16 snare/16 hat/16 hat/16 hat/16 kick/16 hat/16 kick/16 hat/16 snare/16 hat/16 hat/16 hat/16 |
end
def kC:
  | crash/8 hat/16 hat/16 snare/16 hat/16 hat/16 hat/16 kick/16 hat/16 kick/16 hat/16 snare/16 snare/16 snare/16 snare/16 |
end
def kB:
  | kick/4 rim/8 rim/8 rim/8 rim/8 rim/4 |
end
def pumpl:
  | A1/4 r/4 A1/4 r/4 |
end

; ---- the start-up ----
section intro bars=4
  2: {vol 70} @ost*4
  4: | r/1 | @pump | @pump | @pump |
  6: | r/1 | r/1 | @h4*4 | @s16*4 |
end

; ---- the theme: Am Am F G | Am Am F E ----
section A bars=8
  1: {vol 82} @thA
  2: @ost @ost @ost-4 @ost+2 @ost @ost @ost-4 @ost-5
  4: @pump @pump @pump-4 @pump+2 @pump @pump @pump-4 @pump-5
  6: {vol 72} @kA*7 @roll
end

; ---- the bridge: the brass rests, the strings hold, the koto runs: F G Am Am F G E E ----
section B bars=8
  2: {vol 52} @ost-4 @ost+2 @ost @ost @ost-4 @ost+2 @ost-5 @ost-5
  3: {vol 62} @arpM @arpM+2 @arpm @arpm @arpM @arpM+2 @arpM-1 @arpM-1
  4: {vol 70} @pumpl-4 @pumpl+2 @pumpl @pumpl @pumpl-4 @pumpl+2 @pumpl-5 @pumpl-5
  5: {vol 62} | A3/1 | B3/1 | C4/1 | C4/1 | A3/1 | B3/1 | G#3/1 | G#3/1 |
  6: {vol 66} @kB*7 | @s16*4 |
end

; ---- the theme again, with the horns a third below and the strings under it ----
section A2 bars=8
  1: {vol 82} @thA
  2: {vol 70} @ost @ost @ost-4 @ost+2 @ost @ost @ost-4 @ost-5
  4: {vol 80} @pump @pump @pump-4 @pump+2 @pump @pump @pump-4 @pump-5
  5: {vol 58} | C4/1 | C4/1 | A3/1 | B3/1 | C4/1 | C4/1 | A3/1 | G#3/1 |
  6: {vol 74} @kA*7 @roll
  7: {vol 60} @thAh
end

; ---- the push: the theme climbing, Am Dm C G | Am Dm Am E ----
section C bars=8
  1: {vol 86} @thC
  2: {vol 74} @ost @ost+5 @ost+3 @ost+2 @ost @ost+5 @ost @ost-5
  4: {vol 84} @pump @pump+5 @pump+3 @pump+2 @pump @pump+5 @pump @pump-5
  5: {vol 62} | C4/1 | F4/1 | E4/1 | B3/1 | C4/1 | F4/1 | C4/1 | G#3/1 |
  6: {vol 80} @kC*7 @roll
end

form intro loop A B A2 C
