; Livia, senator and quaestor of the Emerald Sun: "Aerarium", an elegant waltz in B minor.
; Original composition for tangoAW2. A harp turns over the chords, a flute sings a refined line over them and a clarinet
; answers it; the drums only count the beat, quietly, like coins on a table. The chord on the end of each phrase
; (F# with an A# in it) leaves the question open, and the clarinet's chromatic step in the middle section is the hint of intrigue.
;
; Form: two bars of harp, then the loop: the flute's phrase (A), the clarinet's phrase with the flute above it (A2),
; the middle section in D (B), and the phrase a last time with the strings (A3). 32 bars of 3/4 at 104 beats a minute: about 56 s.
song livia
tempo 104
meter 3/4
reverb 173
priority 0

inst flute   = A.23  shift=-12      ; a flute with its own vibrato in the sample
inst clar    = A.71  shift=-12      ; a clarinet
inst harp    = A.117                ; the plucked string
inst bass    = A.34  shift=24       ; a plucked bass
inst strings = A.48
inst glint   = A.29                 ; a small bright pluck for the top of the harp's turns
inst kit     = A.120

hit kick=36 rim=37 clap=39 snare=40 hat=44 ohat=46 crash=49

track 1 inst=flute   vol=82 pan=6   vel=100 gate=94 gain=1.2
track 2 inst=clar    vol=70 pan=-12 vel=96  gate=94 gain=1.0
track 3 inst=harp    vol=74 pan=20  vel=100 gate=100 gain=1.3
track 4 inst=bass    vol=74 pan=-4  vel=112 gate=70 gain=1.0
track 5 inst=strings vol=54 pan=-18 vel=84  gate=100 gain=1.4
track 6 inst=kit     vol=44 pan=0   vel=100 gate=100 gain=3.2
track 7 inst=glint   vol=50 pan=28  vel=110 gate=80 gain=2.5

; ---- the harp: six eighths a bar. Bm written; Em is -7; major chords: G written, D is +7; the dominant F# is its own ----
def hm:
  | B2/8 F#3/8 B3/8 D4/8 B3/8 F#3/8 |
end
def hM:
  | G2/8 D3/8 G3/8 B3/8 G3/8 D3/8 |
end
def hD:
  | F#2/8 C#3/8 F#3/8 A#3/8 F#3/8 C#3/8 |
end
; ---- the bass: root, fifth (Bm written; G is -4, Em -7, D +3, F# -5) ----
def pb:
  | B1/4 r/4 F#2/4 |
end

; ---- the flute's phrase: Bm G Em F# | Bm D Em F# ----
def thA:
  | F#5/2 B5/4 |
  | A5/4 G5/4 E5/4 |
  | F#5/4. E5/8 D5/4 |
  | C#5/2 A#4/4 |
  | B4/4 D5/4 F#5/4 |
  | A5/2 F#5/4 |
  | G5/4 E5/4 B4/4 |
  | C#5/2. |
end
; the same, in the clarinet, with small turns
def thA2:
  | F#5/4. G5/16 F#5/16 B5/4 |
  | A5/4 G5/4. E5/8 |
  | F#5/4. E5/8 D5/4 |
  | C#5/2 A#4/4 |
  | B4/4 D5/4 F#5/4 |
  | A5/4. G5/8 F#5/4 |
  | G5/4 E5/4 B4/4 |
  | C#5/2. |
end
; the flute above the clarinet's answer: held notes a sixth or an octave over it
def thAhi:
  | B5/2. |
  | C6/2. |
  | B5/2. |
  | A#5/2. |
  | D6/2. |
  | C#6/2. |
  | B5/2. |
  | E#6/2. |
end
; ---- the middle section in D: D A Bm G | Em A D F# ----
def thB:
  | D5/4 F#5/4 A5/4 |
  | G#5/4 A5/4 E5/4 |
  | D5/2 F#5/4 |
  | B4/4 D5/4 G5/4 |
  | E5/4 G5/4 B5/4 |
  | A5/4. G5/8 E5/4 |
  | F#5/2. |
  | E#5/4 F#5/4 A#4/4 |
end

; ---- strings: held dyads ----
def holdA:
  | F#4/2. | D4/2. | E4/2. | C#4/2. | F#4/2. | A4/2. | E4/2. | C#4/2. |
end
def holdB:
  | A4/2. | E4/2. | F#4/2. | D4/2. | G4/2. | E4/2. | A4/2. | C#4/2. |
end

; ---- coins: the waltz counted quietly ----
def kw:
  | rim/4 hat/4 hat/4 |
end
def kwc:
  | rim/4 hat/4 clap/4 |
end

def gl:
  | r/2 D6/4 |
end
def glend:
  | r/2 C#6/4 |
end

; ---- two bars of harp ----
section intro bars=2
  3: {vol 74} @hm @hm
end

; ---- A: the flute (Bm G Em F# | Bm D Em F#) ----
section A bars=8
  1: {vol 82} @thA
  3: {vol 74} @hm @hM @hm-7 @hD @hm @hM+7 @hm-7 @hD
  4: {vol 74} @pb @pb-4 @pb-7 @pb-5 @pb @pb+3 @pb-7 @pb-5
  5: {vol 50} @holdA
  6: {vol 44} @kw*7 @kwc
end

; ---- A2: the clarinet takes the phrase, the flute holds notes over it ----
section A2 bars=8
  1: {vol 56} @thAhi
  2: {vol 76} @thA2
  3: {vol 74} @hm @hM @hm-7 @hD @hm @hM+7 @hm-7 @hD
  4: {vol 74} @pb @pb-4 @pb-7 @pb-5 @pb @pb+3 @pb-7 @pb-5
  5: {vol 54} @holdA
  6: {vol 46} @kw*7 @kwc
end

; ---- B: the middle section in D (D A Bm G | Em A D F#), the clarinet's chromatic step, coins on the top ----
section B bars=8
  2: {vol 76} @thB
  3: {vol 74} @hM+7 @hM+2 @hm @hM @hm-7 @hM+2 @hM+7 @hD
  4: {vol 74} @pb+3 @pb-2 @pb @pb-4 @pb-7 @pb-2 @pb+3 @pb-5
  5: {vol 52} @holdB
  6: {vol 48} @kwc*8
  7: {vol 50} @gl*7 @glend
end

; ---- A3: the phrase a last time, with the turns, the strings and the coins ----
section A3 bars=8
  1: {vol 84} @thA2
  3: {vol 76} @hm @hM @hm-7 @hD @hm @hM+7 @hm-7 @hD
  4: {vol 76} @pb @pb-4 @pb-7 @pb-5 @pb @pb+3 @pb-7 @pb-5
  5: {vol 58} @holdA
  6: {vol 46} @kw*7 @kwc
  7: {vol 46} @gl*7 @glend
end

form intro loop A A2 B A3
