track 2 inst=brass vol=90 pan=12 vel=110 gate=80 gain=1.070 
track 3 inst=bass vol=100 pan=0 vel=118 gate=70 gain=1.902 
track 4 inst=kit vol=76 pan=0 vel=110 gate=100 gain=0.654 

